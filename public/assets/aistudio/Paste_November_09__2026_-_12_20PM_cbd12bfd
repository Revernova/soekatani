          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-slate-900">${ord.customerName}</span>
              <span class="font-mono text-[10px] bg-white px-2 py-0.5 rounded border border-amber-200 text-slate-600">${ord.orderId}</span>
              <span class="text-[10px] bg-amber-500 text-slate-950 font-black px-2 py-0.5 rounded-full">Perlu Diproses</span>
            </div>
            <p class="text-[11px] text-slate-600 mt-1">${ord.items.map(i => `${i.qty}x ${i.name}`).join(', ')} &bull; <strong class="text-brand-900">${formatRupiah(ord.total)}</strong></p>
          </div>
          <button onclick="openModalShipping('${ord.orderId}')" class="px-3.5 py-1.5 rounded-lg bg-brand-800 hover:bg-brand-900 text-white font-bold text-xs self-start sm:self-auto flex items-center gap-1.5 shadow-xs">
            <i class="fa-solid fa-truck-ramp-box"></i>
            <span>Atur Pengiriman</span>
          </button>
        </div>
      `).join('');
    }

    /* ==========================================================================
       SELLER PORTAL: KELOLA & TAMBAH PRODUK
       ========================================================================== */
    function renderSellerProductsTable(filteredList = null) {
      const tbody = document.getElementById('seller-products-table-body');
      const list = filteredList || PRODUCTS;

      document.getElementById('seller-product-count-badge').innerText = PRODUCTS.length;
      document.getElementById('metric-active-products').innerText = `${PRODUCTS.length} Item`;

      if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">Tidak ada produk ditemukan.</td></tr>`;
        return;
      }

      tbody.innerHTML = list.map(p => `
        <tr class="hover:bg-slate-50 transition">
          <td class="p-3.5 flex items-center gap-3">
            <img src="${p.image}" class="w-10 h-10 rounded-lg object-cover bg-slate-100 flex-shrink-0">
            <div>
              <div class="font-bold text-slate-900 text-xs">${p.name}</div>
              <div class="text-[10px] text-slate-400">Terjual: ${p.soldCount || 0} kg</div>
            </div>
          </td>
          <td class="p-3.5">
            <span class="px-2 py-0.5 bg-slate-100 rounded-full text-[10px] font-bold text-slate-700">${p.category}</span>
          </td>
          <td class="p-3.5">
            <div class="font-extrabold text-brand-900">${formatRupiah(p.price)}</div>
            <div class="text-[10px] text-slate-400">per ${p.unit}</div>
          </td>
          <td class="p-3.5">
            <div class="flex items-center gap-2">
              <span class="font-bold ${(p.stock || 50) < 20 ? 'text-red-500' : 'text-slate-800'}">${p.stock || 50} kg</span>
              <button onclick="quickAdjustStock('${p.id}', 10)" title="Tambah 10kg stok" class="w-5 h-5 rounded bg-slate-100 hover:bg-emerald-100 text-slate-600 hover:text-emerald-800 flex items-center justify-center font-bold text-[10px]">+</button>
            </div>
          </td>
          <td class="p-3.5 text-slate-600 text-[11px]">${p.farmerLoc}</td>
          <td class="p-3.5 text-right space-x-1 whitespace-nowrap">
            <button onclick="editProduct('${p.id}')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 rounded text-slate-700 font-semibold text-[11px]" title="Edit">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button onclick="deleteProduct('${p.id}')" class="px-2 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded font-semibold text-[11px]" title="Hapus">
              <i class="fa-regular fa-trash-can"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }

    function filterSellerProducts(term) {
      const q = term.toLowerCase();
      const filtered = PRODUCTS.filter(p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
      renderSellerProductsTable(filtered);
    }

    function quickAdjustStock(id, amount) {
      const prod = PRODUCTS.find(p => p.id === id);
      if (prod) {
        prod.stock = (prod.stock || 50) + amount;
        renderSellerProductsTable();
        showToast(`Stok ${prod.name} ditambahkan +${amount} kg`);
      }
    }

    function openModalAddProduct() {
      document.getElementById('modal-product-title').innerText = 'Tambah Hasil Panen Baru';
      document.getElementById('input-prod-id').value = '';
      document.getElementById('input-prod-name').value = '';
      document.getElementById('input-prod-category').value = 'Buah';
      document.getElementById('input-prod-unit').value = '1 kg';
      document.getElementById('input-prod-price').value = '';
      document.getElementById('input-prod-original-price').value = '';
      document.getElementById('input-prod-stock').value = '50';
      document.getElementById('input-prod-loc').value = 'Indramayu, Jawa Barat';
      document.getElementById('input-prod-image').value = '';
      document.getElementById('input-prod-desc').value = '';

      document.getElementById('modal-product').classList.remove('hidden');
    }

    function closeModalAddProduct() {
      document.getElementById('modal-product').classList.add('hidden');
    }

    function setSampleImage(type) {
      const url = SAMPLE_IMAGES[type];
      if (url) {
        document.getElementById('input-prod-image').value = url;
      }
    }

    function editProduct(id) {
      const p = PRODUCTS.find(item => item.id === id);
      if (!p) return;

      document.getElementById('modal-product-title').innerText = 'Edit Hasil Panen';
      document.getElementById('input-prod-id').value = p.id;
      document.getElementById('input-prod-name').value = p.name;
      document.getElementById('input-prod-category').value = p.category;
      document.getElementById('input-prod-unit').value = p.unit;
      document.getElementById('input-prod-price').value = p.price;
      document.getElementById('input-prod-original-price').value = p.originalPrice || '';
      document.getElementById('input-prod-stock').value = p.stock || 50;
      document.getElementById('input-prod-loc').value = p.farmerLoc;
      document.getElementById('input-prod-image').value = p.image;
      document.getElementById('input-prod-desc').value = p.desc || '';

      document.getElementById('modal-product').classList.remove('hidden');
    }

    function handleSaveProduct(e) {
      e.preventDefault();
      const id = document.getElementById('input-prod-id').value;
      const name = document.getElementById('input-prod-name').value;
      const category = document.getElementById('input-prod-category').value;
      const unit = document.getElementById('input-prod-unit').value;
      const price = Number(document.getElementById('input-prod-price').value);
      const originalPrice = Number(document.getElementById('input-prod-original-price').value) || (price + 5000);
      const stock = Number(document.getElementById('input-prod-stock').value) || 50;
      const farmerLoc = document.getElementById('input-prod-loc').value;
      let image = document.getElementById('input-prod-image').value;
      const desc = document.getElementById('input-prod-desc').value;

      if (!image) {
        image = 'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=600&q=80';
      }

      if (id) {
        // Update Existing
        const idx = PRODUCTS.findIndex(p => p.id === id);
        if (idx > -1) {
          PRODUCTS[idx] = {
            ...PRODUCTS[idx],
            name, category, unit, price, originalPrice, stock, farmerLoc, image, desc
          };
          showToast(`Produk "${name}" berhasil diperbarui!`);
        }
      } else {
        // Add New
        const newProduct = {
          id: 'p_' + Date.now(),
          name,
          category,
          price,
          originalPrice,
          rating: 5.0,
          reviewsCount: 1,
          soldCount: 0,
          stock,
          unit,
          farmerName: 'Petani Sari Mulyani',
          farmerLoc,
          image,
          gallery: [image],
          desc,
          isBestSeller: false
        };
        PRODUCTS.unshift(newProduct);
        showToast(`Panen baru "${name}" berhasil ditambahkan ke etalase!`);
      }

      closeModalAddProduct();
      renderSellerProductsTable();
      renderHomeProducts();
      renderCatalog();
    }

    function deleteProduct(id) {
      const idx = PRODUCTS.findIndex(p => p.id === id);
      if (idx > -1) {
        const name = PRODUCTS[idx].name;
        PRODUCTS.splice(idx, 1);
        renderSellerProductsTable();
        renderHomeProducts();
        renderCatalog();
        showToast(`Produk "${name}" telah dihapus.`);
      }
    }

    /* ==========================================================================
       SELLER PORTAL: MANAJEMEN PENGIRIMAN & PESANAN
       ========================================================================== */
    function filterSellerOrdersByStatus(status) {
      currentOrderFilterStatus = status;
      document.querySelectorAll('.ord-filter-btn').forEach(b => {
        b.classList.remove('bg-white', 'shadow-xs', 'text-slate-900');
        b.classList.add('text-slate-600');
      });

      if (status === 'all') document.getElementById('btn-ord-all').classList.add('bg-white', 'shadow-xs', 'text-slate-900');
      if (status === 'Perlu Diproses') document.getElementById('btn-ord-pending').classList.add('bg-white', 'shadow-xs', 'text-slate-900');
      if (status === 'Dalam Pengiriman') document.getElementById('btn-ord-shipping').classList.add('bg-white', 'shadow-xs', 'text-slate-900');
      if (status === 'Selesai') document.getElementById('btn-ord-done').classList.add('bg-white', 'shadow-xs', 'text-slate-900');

      renderSellerOrders();
    }

    function renderSellerOrders() {
      const container = document.getElementById('seller-orders-container');
      const list = currentOrderFilterStatus === 'all' 
        ? SELLER_ORDERS 
        : SELLER_ORDERS.filter(o => o.status === currentOrderFilterStatus);

      if (list.length === 0) {
        container.innerHTML = `
          <div class="bg-white p-8 rounded-2xl border border-slate-200/80 text-center text-slate-400">
            <i class="fa-solid fa-box-open text-3xl mb-2"></i>
            <p class="text-xs font-bold text-slate-700">Tidak ada pesanan di kategori ini</p>
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(ord => {
        let badgeColor = 'bg-amber-100 text-amber-800 border-amber-300';
        if (ord.status === 'Dalam Pengiriman') badgeColor = 'bg-blue-100 text-blue-800 border-blue-300';
        if (ord.status === 'Selesai') badgeColor = 'bg-emerald-100 text-emerald-800 border-emerald-300';

        return `
          <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-xs space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
              <div>
                <span class="font-mono font-bold text-xs text-slate-900">${ord.orderId}</span>
                <span class="text-xs text-slate-400 mx-1.5">&bull;</span>
                <span class="text-xs text-slate-500">${ord.date}</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${badgeColor}">
                ${ord.status}
              </span>
            </div>

            <!-- Customer & Item Info -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
              <div>
                <div class="text-[10px] uppercase font-bold text-slate-400">Penerima & Alamat:</div>
                <div class="font-bold text-slate-800 mt-0.5">${ord.customerName} (${ord.phone})</div>
                <div class="text-slate-500 text-[11px] mt-0.5">${ord.address}</div>
              </div>

              <div>
                <div class="text-[10px] uppercase font-bold text-slate-400">Komoditas Panen:</div>
                <div class="space-y-1 mt-0.5">
                  ${ord.items.map(item => `
                    <div class="text-slate-700 flex justify-between pr-4">
                      <span>${item.qty}x ${item.name} (${item.unit})</span>
                      <span class="font-semibold">${formatRupiah(item.price * item.qty)}</span>
                    </div>
                  `).join('')}
                </div>
              </div>

              <div class="border-t md:border-t-0 md:border-l md:pl-4 border-slate-100 flex flex-col justify-between">
                <div>
                  <div class="text-[10px] uppercase font-bold text-slate-400">Ekspedisi & Resi:</div>
                  <div class="font-bold text-slate-800 mt-0.5">${ord.courier}</div>
                  <div class="font-mono text-[11px] text-brand-900 font-bold">${ord.resi}</div>
                  <div class="mt-1 text-slate-500 text-[11px]">Metode: ${ord.paymentMethod}</div>
                </div>
                <div class="mt-2 text-right">
                  <span class="text-[10px] text-slate-400">Total Pembayaran:</span>
                  <div class="text-sm font-black text-brand-800">${formatRupiah(ord.total)}</div>
                </div>
              </div>
            </div>

            <!-- Action Buttons for Order Logistics -->
            <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-end gap-2">
              <button onclick="printShippingLabel('${ord.orderId}')" class="px-3 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-print"></i>
                <span>Cetak Label Pengiriman</span>
              </button>

              ${ord.status === 'Perlu Diproses' ? `
                <button onclick="openModalShipping('${ord.orderId}')" class="px-4 py-1.5 rounded-xl bg-brand-800 hover:bg-brand-900 text-white font-bold text-xs flex items-center gap-1.5 shadow-xs">
                  <i class="fa-solid fa-truck-ramp-box"></i>
                  <span>Atur Pengiriman & Pickup</span>
                </button>
              ` : ''}

              ${ord.status === 'Dalam Pengiriman' ? `
                <button onclick="markOrderCompleted('${ord.orderId}')" class="px-4 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-1.5 shadow-xs">
                  <i class="fa-solid fa-circle-check"></i>
                  <span>Tandai Selesai Diterima</span>
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function openModalShipping(orderId) {
      const ord = SELLER_ORDERS.find(o => o.orderId === orderId);
      if (!ord) return;

      document.getElementById('shipping-order-id').value = ord.orderId;
      document.getElementById('shipping-customer-name').innerText = ord.customerName;
      document.getElementById('shipping-customer-address').innerText = ord.address;
      document.getElementById('shipping-order-num').innerText = `No. Pesanan: ${ord.orderId}`;
      document.getElementById('shipping-tracking-number').value = ord.resi || ('SKT-' + Math.floor(1000 + Math.random() * 9000) + '-COLD');

      document.getElementById('modal-shipping').classList.remove('hidden');
    }

    function closeModalShipping() {
      document.getElementById('modal-shipping').classList.add('hidden');
    }

    function generateRandomResi() {
      const code = 'SKT-' + Math.floor(1000 + Math.random() * 9000) + '-EXP';
      document.getElementById('shipping-tracking-number').value = code;
    }

    function submitShippingDispatch() {
      const orderId = document.getElementById('shipping-order-id').value;
      const courier = document.getElementById('shipping-courier-select').value;
      const resi = document.getElementById('shipping-tracking-number').value;

      const ord = SELLER_ORDERS.find(o => o.orderId === orderId);
      if (ord) {
        ord.courier = courier;
        ord.resi = resi;
        ord.status = 'Dalam Pengiriman';
        showToast(`Pesanan ${orderId} siap di-pickup oleh ${courier}`);
      }

      closeModalShipping();
      renderSellerOrders();
      renderSellerDashboard();
    }

    function markOrderCompleted(orderId) {
      const ord = SELLER_ORDERS.find(o => o.orderId === orderId);
      if (ord) {
        ord.status = 'Selesai';
        showToast(`Pesanan ${orderId} berhasil diselesaikan! Dana diteruskan ke saldo petani.`);
        renderSellerOrders();
        renderSellerDashboard();
      }
    }

    function printShippingLabel(orderId) {
      const ord = SELLER_ORDERS.find(o => o.orderId === orderId);
      if (!ord) return;

      document.getElementById('label-courier-name').innerText = ord.courier.includes('Cold') ? 'Cold-Chain ❄️' : 'Reguler Sayur';
      document.getElementById('label-resi').innerText = ord.resi;
      document.getElementById('label-customer').innerText = `${ord.customerName} (${ord.phone})`;
      document.getElementById('label-address').innerText = ord.address;

      document.getElementById('modal-label').classList.remove('hidden');
    }

    /* ==========================================================================
       CHECKOUT & PAYMENT LOGIC (Defined directly to prevent ReferenceError)
       ========================================================================== */
    function processOrderPayment() {
      if (typeof cart === 'undefined' || cart.length === 0) {
        showToast('Keranjang belanja kosong');
        return;
      }

      const shippingCost = typeof currentShippingCost !== 'undefined' ? currentShippingCost : 15000;
      const selectedPaymentEl = document.querySelector('input[name="payment_method"]:checked');
      const paymentMethod = selectedPaymentEl ? selectedPaymentEl.value : 'QRIS Instan';
      const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      const grandTotal = subtotal + shippingCost;
      const newOrderId = 'ST-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);

      // Auto Add to Seller Orders database
      const newSellerOrder = {
        orderId: newOrderId,
        customerName: 'Budi Santoso',
        phone: '0812-3456-7890',
        address: 'Jl. Melati No. 12, Kel. Menteng, Jakarta Selatan',
        date: 'Hari ini, baru saja',
        items: cart.map(item => ({
          name: item.variant || item.name,
          qty: item.qty,
          price: item.price,
          unit: item.unit || '1 kg'
        })),
        subtotal: subtotal,
        shippingFee: shippingCost,
        total: grandTotal,
        paymentMethod: paymentMethod,
        status: 'Perlu Diproses',
        courier: shippingCost === 25000 ? 'Same Day Instant Express' : 'SoekaTani Cold-Chain Express',
        resi: 'SKT-' + Math.floor(1000 + Math.random() * 9000) + '-COLD'
      };

      SELLER_ORDERS.unshift(newSellerOrder);
      renderSellerDashboard();

      // Update success receipt UI if elements exist
      const orderNumEl = document.getElementById('success-order-id');
      const orderTotalEl = document.getElementById('success-order-total');
      const orderDateEl = document.getElementById('success-order-date');

      if (orderNumEl) orderNumEl.innerText = '#' + newOrderId;
      if (orderTotalEl) orderTotalEl.innerText = formatRupiah(grandTotal);
      if (orderDateEl) {
        const now = new Date();
        orderDateEl.innerText = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + 
                                now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';
      }

      // Clear cart
      cart = [];
      if (typeof updateCartUI === 'function') updateCartUI();

      // Navigate to success page
      if (typeof navigateTo === 'function') {
        navigateTo('success');
      }

      showToast('🎉 Pembayaran berhasil dikonfirmasi!');
    }

    /* Additional Window Load Call */
    window.addEventListener('DOMContentLoaded', () => {
      renderSellerDashboard();
      renderSellerProductsTable();
      renderSellerOrders();
    });
  </script>
</body>
</html>